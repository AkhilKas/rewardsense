# ==============================================
# RewardSense Inference Service
# ==============================================
# Serves the FastAPI API + React frontend.
#
# Build:
#   docker build -f Dockerfile.serving -t rewardsense-serving .
#
# Run locally:
#   docker run --rm -p 8080:8080 \
#     -e EXECUTION_ENV=local \
#     -e MLFLOW_TRACKING_URI=http://mlflow-server:5000 \
#     rewardsense-serving
# ==============================================

# ===================== Stage 1: Build frontend =====================
FROM node:20-slim AS frontend-build

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ ./
# VITE_API_URL is empty so the frontend uses same-origin requests in production
RUN VITE_API_URL="" npm run build

# ===================== Stage 2: Python serving =====================
FROM python:3.11-slim

# ---- System dependencies ----
# libgomp1  : required by LightGBM for OpenMP threading
# curl      : used by the container health-check probe
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---- Non-root user ----
RUN groupadd --gid 1001 appgroup \
    && useradd --uid 1001 --gid appgroup --no-create-home appuser

# ---- Working directory ----
WORKDIR /app

# ---- Install Python dependencies ----
# Copy requirements first to leverage Docker layer cache.
COPY requirements-serving.txt /tmp/requirements-serving.txt
RUN pip install --no-cache-dir --upgrade pip setuptools \
    && pip install --no-cache-dir -r /tmp/requirements-serving.txt \
    && rm /tmp/requirements-serving.txt

# ---- Copy project source ----
COPY setup.py ./setup.py
COPY README.md ./README.md
COPY src/ ./src/
COPY config/ ./config/

# ---- Copy built frontend into /app/static ----
COPY --from=frontend-build /frontend/dist ./static

# ---- Install project package ----
RUN pip install --no-cache-dir -e .

# ---- Ownership ----
RUN chown -R appuser:appgroup /app
USER appuser

# ---- Environment variables ----
# Execution environment: "local" or "gcp"
ENV EXECUTION_ENV=local

# MLflow tracking URI (override in docker-compose / Cloud Run env)
ENV MLFLOW_TRACKING_URI=http://mlflow-server:5000

# Disable MLflow tracking by default in serving; enable via env override
ENV ENABLE_MLFLOW_TRACKING=false

# LLM explanations disabled by default; set to "true" + supply GCP creds to enable
ENV ENABLE_LLM_EXPLANATIONS=false

# Gemini-based merchant category classification (falls back to keyword map if disabled/unavailable)
ENV ENABLE_LLM_CATEGORY=true

# GCP settings (override via env or Secret Manager)
ENV GCP_PROJECT_ID=rewardsense
ENV VERTEX_LOCATION=us-central1
ENV LLM_MODEL=gemini-2.5-flash

# Frontend static directory
ENV STATIC_DIR=/app/static

# Python settings
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

# Uvicorn workers — override in production (e.g., 2-4 for Cloud Run)
ENV UVICORN_WORKERS=2

# ---- Expose HTTP port ----
EXPOSE 8080

# ---- Health check ----
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl --fail http://localhost:8080/health || exit 1

# ---- Startup script ----
# Fetches merged_cards.json from GCS before starting the server so the
# catalog always reflects the latest pipeline run without baking data
# into the image.  Falls back gracefully if GCS is unreachable.
COPY --chown=appuser:appgroup scripts/fetch_catalog.sh /app/scripts/fetch_catalog.sh
RUN chmod +x /app/scripts/fetch_catalog.sh

# ---- Entrypoint ----
CMD ["/bin/sh", "-c", "/app/scripts/fetch_catalog.sh && uvicorn app.server:create_app --factory --host 0.0.0.0 --port 8080 --workers ${UVICORN_WORKERS} --log-level info"]
